{
  "name": "smart-travel-planner-app",
  "version": "1.0.0",
  "description": "Smart Travel Planner & Itinerary Builder API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "mocha --require tests/setup.js tests/**/*.test.js --exit --timeout 10000",
    "test:routes": "mocha --require tests/setup.js tests/routes/**/*.test.js --exit --timeout 10000",
    "test:services": "mocha --require tests/setup.js tests/services/**/*.test.js tests/repositories/**/*.test.js --exit --timeout 10000",
    "test:coverage": "nyc --reporter=text --reporter=lcov npm test",
    "test:watch": "mocha --require tests/setup.js tests/**/*.test.js --watch"
  },
  "keywords": [
    "travel",
    "planner",
    "itinerary",
    "api"
  ],
  "author": "Kikunmi",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-validator": "^7.0.0",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^7.5.0",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "chai": "^4.3.10",
    "mocha": "^10.2.0",
    "nodemon": "^3.0.1",
    "nyc": "^18.0.0",
    "sinon": "^17.0.1",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=20",
    "npm": ">=8.0.0"
  },
  "nyc": {
    "all": true,
    "include": [
      "app.js",
      "src/**/*.js"
    ],
    "exclude": [
      "tests/**/*.js"
    ]
  }
}
